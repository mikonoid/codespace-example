{
  "name": "Node.js with Docker",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "forwardPorts": [3000],
  "mounts": [
    "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind"
  ],
  "postCreateCommand": "npm install",
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}
